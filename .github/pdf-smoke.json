{"title": "\u0643\u064a\u0641\u064a\u0629 \u062a\u0643\u064a\u064a\u0644 \u0627\u0644\u0639\u0645\u0627\u0631 \u0648\u0627\u0644\u0648\u0631\u0642\u0629", "content": {"header": {"company": "\u0634\u0631\u0643\u0629 \u0623\u0628\u0648 \u062f\u064a\u0648\u0627\u0646 \u0644\u0644\u062a\u0639\u0647\u062f\u0627\u062a", "subtitle": "\u0643\u064a\u0641\u064a\u0629 \u062a\u0643\u064a\u064a\u0644 \u0627\u0644\u0639\u0645\u0627\u0631 \u0648\u0627\u0644\u0648\u0631\u0642\u0629", "phones": "03781899 | 70579612", "website": "d1constructionsarl.com"}, "sections": [{"title": "\u0639\u0645\u0627\u0631 \u062d\u062c\u0627\u0631 \u0627\u0644\u0628\u0627\u0637\u0648\u0646", "kind": "numbered", "items": [{"text": "$5 \u0644\u0644\u0645\u062a\u0631 \u0627\u0644\u0645\u0631\u0628\u0639 \u0639\u0644\u0649 \u0623\u0633\u0627\u0633 \u062a\u0643\u064a\u064a\u0644 \u0647\u0646\u062f\u0633\u064a \u0641\u0642\u0637 \u062a\u062d\u0633\u0645 \u0646\u0635\u0641 \u0627\u0644\u062e\u0631\u0627\u0642\u0627\u062a."}, {"text": "\u0643\u0644 \u0634\u064a \u062a\u062d\u062a \u0627\u0644\u0645\u062a\u0631 \u062a\u062d\u0633\u0628 \u0645\u062a\u0631 \u0645\u0631\u0628\u0639."}, {"text": "\u0643\u0644 \u0634\u064a \u062a\u062d\u062a \u0627\u0644\u062e\u0645\u0633\u064a\u0646 \u0633\u0646\u062a\u064a\u0645\u062a\u0631 \u062a\u062d\u0633\u0628 \u0643\u0644 \u0645\u062a\u0631\u064a\u0646 \u0645\u062a\u0631 \u0645\u0631\u0628\u0639."}]}, {"title": "\u0627\u0644\u0648\u0631\u0642\u0629", "kind": "numbered", "items": [{"text": "\u0648\u0631\u0642\u0629 \u062e\u0627\u0631\u062c\u064a\u0629 \u0645\u0639 \u0627\u0644\u0633\u0642\u0627\u0644\u0629 $10 \u0644\u0644\u0645\u062a\u0631 \u0627\u0644\u0645\u0631\u0628\u0639 \u0639\u0644\u0649 \u0623\u0633\u0627\u0633 \u0643\u064a\u0644 \u0647\u0646\u062f\u0633\u064a \u0641\u0642\u0637 \u062a\u062d\u0633\u0645 \u0627\u0644\u062e\u0631\u0627\u0642\u0627\u062a\u060c \u0645\u0647\u0645\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0633\u0645\u0627\u0643\u0629 \u0648\u0627\u0644\u0643\u0645\u064a\u0629 \u0648\u0639\u062f\u062f \u0645\u0631\u0627\u062a \u0627\u0644\u062a\u0648\u0631\u064a\u0642 - \u0648\u062f\u0639."}, {"text": "\u062a\u0637\u0628\u064a\u0642 \u0642\u062f\u0629 \u0639\u0627\u062f\u064a\u0629 3 \u0623\u0645\u062a\u0627\u0631 \u0645\u0639 \u062a\u0637\u0644\u064a\u0639 \u0627\u0644\u0631\u0645\u0644 $5 \u0639\u0644\u0649 \u0623\u0633\u0627\u0633 \u0643\u064a\u0644 \u0647\u0646\u062f\u0633\u064a \u062a\u062d\u0633\u0645 \u0646\u0635\u0641 \u0627\u0644\u062e\u0631\u0627\u0642\u0627\u062a."}, {"text": "\u0648\u0631\u0642\u0629 \u062f\u0627\u062e\u0644\u064a\u0629 \u0648\u062f\u0639 \u0627\u0645\u0627\u0645\u0627\u062a \u0648\u0632\u0648\u0627\u064a\u0627 $8 \u0644\u0644\u0645\u062a\u0631 \u0627\u0644\u0645\u0631\u0628\u0639 \u0639\u0644\u0649 \u0623\u0633\u0627\u0633 \u0643\u064a\u0644 \u0647\u0646\u062f\u0633\u064a \u0641\u0642\u0637 \u062a\u062d\u0633\u0645 \u0646\u0635\u0641 \u0627\u0644\u062e\u0631\u0627\u0642\u0627\u062a."}]}, {"title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0643\u064a\u0644", "kind": "notes", "items": [{"text": "\u0627\u0644\u0633\u0646\u0651\u0629 \u062a\u0643\u0627\u0644 \u0643\u0644 \u0645\u062a\u0631\u064a\u0646 \u062c\u0631 \u0628\u0645\u062a\u0631 \u0645\u0631\u0628\u0639."}, {"text": "\u0627\u0644\u0633\u0644\u0627\u062d\u060c \u0627\u0644\u0634\u0628\u0627\u0628\u064a\u0643 \u0648\u0627\u0644\u0623\u0628\u0648\u0627\u0628 \u0648\u0627\u0644\u062d\u0641\u0627\u0641\u0629 \u062a\u0643\u0627\u0644 \u0643\u0644 \u0645\u062a\u0631 \u062c\u0631 \u0628\u0645\u062a\u0631 \u0645\u0631\u0628\u0639."}, {"text": "\u0648\u0631\u0642\u0629 \u0639\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0623\u0643\u062b\u0631 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0623\u0645\u062a\u0627\u0631 \u062a\u062d\u0633\u0628 \u0645\u0631\u0629 \u0648\u0646\u0635\u0641 \u0645\u0639 \u0627\u0644\u0633\u0642\u0627\u0644\u0629."}, {"text": "\u0648\u0631\u0642\u0629 \u0645\u062c\u0631\u062d \u062a\u0643\u0627\u0644 \u0643\u0644 \u0645\u062a\u0631\u064a\u0646 \u0645\u0631\u0628\u0639 \u0628\u0645\u062a\u0631 \u0645\u0631\u0628\u0639."}]}]}}
